# Copy hii faili kuwa .env kisha jaza.
#
# VITE_API_URL: Endpoint ya backend API.
#  - Dev: acha kuwa '/api/v1' (vite proxy hupeleka kwenye port 8001).
#  - XAMPP/build: ongeza kwa mfano VITE_API_URL=http://127.0.0.1:8001/api/v1
#    kama frontend haitolewi kwenye same origin kama backend.
# VITE_API_URL=/api/v1
#
# VITE_ANALYTICS_ID: Google Analytics 4 Measurement ID (k.m. G-XXXXXXXXXX).
# Ondoa comment kuidhibiti. Ikiwa haipo, analytics hazitumiki kabisa.
# VITE_ANALYTICS_ID=